#!/bin/bash
# 飞书工作日报半自动生成推送 — 每天 ${PUSH_HOUR}:${PUSH_MINUTE} 自动运行
# Pipeline: claude-mem 查今日 observations → Claude 合成三段 → lark-cli bot 私聊推送

set -euo pipefail
export PATH="${NODE_BIN_PATH}:$HOME/.npm-global/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export LANG="zh_CN.UTF-8"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/work-report.config.env"
PROMPT_TEMPLATE="$SCRIPT_DIR/work-report.prompt.md"

TODAY=$(date +%Y-%m-%d)
export TODAY

LOG_DIR="$HOME/Library/Logs/work-report"
STATE_DIR="$HOME/.local/state/work-report"
mkdir -p "$LOG_DIR" "$STATE_DIR"

LOG_FILE="$LOG_DIR/$TODAY.log"
STATE_FILE="$STATE_DIR/$TODAY.json"
RAW_FILE="$STATE_DIR/$TODAY.raw"

exec > >(tee -a "$LOG_FILE") 2>&1

echo "========== 工作日报 $TODAY =========="
echo "开始时间: $(date)"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "❌ 配置文件缺失: $CONFIG_FILE"
    exit 1
fi
# shellcheck source=/dev/null
source "$CONFIG_FILE"

for v in USER_OPEN_ID NOTIFY_OPEN_ID; do
    if [ -z "${!v:-}" ]; then
        echo "❌ 未配置: $v（请编辑 $CONFIG_FILE）"
        exit 1
    fi
done

notify_failure() {
    local exit_code=$?
    local reason="${1:-unknown}"
    echo "❌ 失败: $reason (exit=$exit_code)"
    printf '{"ok":false,"date":"%s","reason":"%s","exit_code":%s,"log":"%s"}\n' \
        "$TODAY" "$reason" "$exit_code" "$LOG_FILE" > "$STATE_FILE"
    lark-cli im +messages-send --user-id "$NOTIFY_OPEN_ID" \
        --text "🚨 工作日报 $TODAY 生成失败
原因: $reason
日志: $LOG_FILE" 2>&1 || echo "⚠️ 告警发送也失败了"
    exit "$exit_code"
}
trap 'notify_failure "trap_ERR_line_$LINENO"' ERR

echo ">>> 收集今日 Claude Code transcripts..."
"$SCRIPT_DIR/work-report-collect-transcripts" "$TODAY" || echo "(collector 失败但继续)"

TRANSCRIPTS_FILE="$STATE_DIR/transcripts-$TODAY.md"
export TRANSCRIPTS_FILE

PROMPT=$(TODAY="$TODAY" USER_OPEN_ID="$USER_OPEN_ID" TRANSCRIPTS_FILE="$TRANSCRIPTS_FILE" envsubst < "$PROMPT_TEMPLATE")

echo ">>> 健康检查：claude headless 登录态..."
# 不烧 token：用 claude config list 触发本地 auth 校验
# 临时禁用 ERR trap + pipefail，避免 claude 非零退出/SIGPIPE 被 trap 抓住
trap - ERR
set +eo pipefail
HEALTH_CHECK=$(claude config list 2>&1)
HEALTH_CHECK=$(echo "$HEALTH_CHECK" | head -3)
set -eo pipefail
trap 'notify_failure "trap_ERR_line_$LINENO"' ERR
if echo "$HEALTH_CHECK" | grep -qiE "not logged in|does not have access|organization does not|please run /login"; then
    echo "❌ claude headless 登录态失效，提前终止（不浪费 600s 跑 claude -p）"
    echo "   实际错误：$HEALTH_CHECK"
    echo ""
    echo "   修复方法：在【真实 Terminal.app 或 iTerm】（不是 Claude Desktop 里的会话）跑："
    echo "     claude /login"
    echo "   完成 OAuth 后，下次 launchd 自动触发就能用，或手动："
    echo "     launchctl kickstart -k gui/\$(id -u)/com.workreport.daily"
    # 通知飞书私聊
    lark-cli im +messages-send --user-id "$NOTIFY_OPEN_ID" --text "❌ 工作日报失败 · $TODAY
原因：claude headless 登录态失效
修复：在终端跑 \`claude /login\` 完成 OAuth" 2>/dev/null || true
    exit 2
fi
echo "✓ claude 登录态正常"

echo ">>> 调用 Claude headless 生成并推送..."
set +e
# macOS 没有 GNU timeout，用 Perl alarm 实现 10 分钟硬兜底
perl -e 'alarm 600; exec @ARGV' claude -p --permission-mode bypassPermissions --model claude-opus-4-6 <<< "$PROMPT" | tee "$RAW_FILE"
CLAUDE_EXIT=${PIPESTATUS[0]}
set -e

if [ "$CLAUDE_EXIT" -ne 0 ]; then
    notify_failure "claude_exit_$CLAUDE_EXIT"
fi

if SENT_LINE=$(grep -m1 '^✅ SENT ' "$RAW_FILE"); then
    echo "✅ 推送成功: $SENT_LINE"
    printf '{"ok":true,"date":"%s","sent_line":"%s","log":"%s"}\n' \
        "$TODAY" "$(echo "$SENT_LINE" | sed 's/"/\\"/g')" "$LOG_FILE" > "$STATE_FILE"
    echo "结束时间: $(date)"
    exit 0
else
    notify_failure "no_sent_flag_in_stdout"
fi
